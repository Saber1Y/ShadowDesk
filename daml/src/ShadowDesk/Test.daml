module ShadowDesk.Test where

import Daml.Script
import DA.Time (addRelTime, hours)
import ShadowDesk.Rfq
import ShadowDesk.Asset
import ShadowDesk.Settlement

expectSome : Text -> Optional a -> a
expectSome label o = case o of
  None -> error label
  Some x -> x

rfqTemplate : Party -> [Party] -> Time -> Text -> BlockTradeRFQ
rfqTemplate buyer dealers expiry reference = BlockTradeRFQ with
  buyer = buyer
  dealers = dealers
  assetToBuy = "cTBILL"
  settlementAsset = "cUSDC"
  amount = 1_000_000.0
  maxPrice = 101.0
  selectionPolicy = LowestPriceThenBidId
  reference = reference
  expiry = expiry

runPrivateRfqLifecycle : Script ()
runPrivateRfqLifecycle = do
  buyer <- allocateParty "buyer"
  dealerA <- allocateParty "dealerA"
  dealerB <- allocateParty "dealerB"
  dealerC <- allocateParty "dealerC"

  now <- getTime
  let expiry = addRelTime now (hours 24)

  rfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA, dealerB] expiry "RFQ-0001")

  rfqDealerA <- query @BlockTradeRFQ dealerA
  assertMsg "Invited dealer A must see the RFQ" (length rfqDealerA == 1)

  rfqDealerB <- query @BlockTradeRFQ dealerB
  assertMsg "Invited dealer B must see the RFQ" (length rfqDealerB == 1)

  rfqDealerC <- query @BlockTradeRFQ dealerC
  assertMsg "Uninvited dealer C must not see the RFQ" (length rfqDealerC == 0)

  proposalACid <- submit dealerA do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.50
      bidId = "BID-A-1"

  proposalBCid <- submit dealerB do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerB
      offeredPrice = 100.20
      bidId = "BID-B-1"

  dealerAViewOfProposalB <- queryContractId dealerA proposalBCid
  assertMsg "Dealer A cannot see Dealer B quote proposal" (dealerAViewOfProposalB == (None : Optional QuoteProposal))

  dealerBViewOfProposalA <- queryContractId dealerB proposalACid
  assertMsg "Dealer B cannot see Dealer A quote proposal" (dealerBViewOfProposalA == (None : Optional QuoteProposal))

  sealedBCid <- submit buyer do
    exerciseCmd proposalBCid AcceptProposal with
      maxPrice = 101.0

  sealedDealerB <- query @SealedQuote dealerB
  assertMsg "Winning dealer sees exactly its own sealed quote" (length sealedDealerB == 1)

  sealedDealerA <- query @SealedQuote dealerA
  assertMsg "Losing dealer sees no sealed quotes" (length sealedDealerA == 0)

  dealerAViewOfSealedB <- queryContractId dealerA sealedBCid
  assertMsg "Losing dealer cannot fetch the winning sealed quote" (dealerAViewOfSealedB == (None : Optional SealedQuote))

  buyerViewOfSealedB <- queryContractId buyer sealedBCid
  let awarded = expectSome "Buyer must see the awarded sealed quote" buyerViewOfSealedB
  assertMsg "Awarded quote carries the RFQ selection policy" (awarded.selectionPolicy == LowestPriceThenBidId)
  assertMsg "Awarded quote records the winning bid id" (awarded.bidId == "BID-B-1")

  submit buyer do
    exerciseCmd rfqCid CloseRfq

runAuthorizationAndReplayBoundaries : Script ()
runAuthorizationAndReplayBoundaries = do
  buyer <- allocateParty "buyer"
  dealerA <- allocateParty "dealerA"
  dealerB <- allocateParty "dealerB"
  dealerC <- allocateParty "dealerC"

  now <- getTime
  let expiry = addRelTime now (hours 24)
  let expired = addRelTime now (hours (-24))

  expiredRfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA, dealerB] expired "RFQ-EXPIRED")

  submitMustFail dealerA do
    exerciseCmd expiredRfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.00
      bidId = "BID-A-EXPIRED"

  liveRfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA, dealerB] expiry "RFQ-0002")

  submitMustFail dealerC do
    exerciseCmd liveRfqCid SubmitQuoteProposal with
      dealer = dealerC
      offeredPrice = 99.00
      bidId = "BID-C-1"

  proposalACid <- submit dealerA do
    exerciseCmd liveRfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.50
      bidId = "BID-A-2"

  submitMustFail dealerA do
    exerciseCmd proposalACid AcceptProposal with
      maxPrice = 101.0

  submitMustFail dealerB do
    exerciseCmd proposalACid AcceptProposal with
      maxPrice = 101.0

  sealedACid <- submit buyer do
    exerciseCmd proposalACid AcceptProposal with
      maxPrice = 101.0

  dealerBViewOfSealedA <- queryContractId dealerB sealedACid
  assertMsg "Non-winning dealer B cannot see the awarded quote" (dealerBViewOfSealedA == (None : Optional SealedQuote))

runQuoteConstraintValidation : Script ()
runQuoteConstraintValidation = do
  buyer <- allocateParty "buyer"
  dealerA <- allocateParty "dealerA"

  now <- getTime
  let expiry = addRelTime now (hours 24)

  rfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA] expiry "RFQ-0003")

  proposalACid <- submit dealerA do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 102.00
      bidId = "BID-A-3"

  submitMustFail buyer do
    exerciseCmd proposalACid AcceptProposal with
      maxPrice = 101.0

runAtomicDvPSettlement : Script ()
runAtomicDvPSettlement = do
  buyer <- allocateParty "buyer"
  dealerA <- allocateParty "dealerA"

  now <- getTime
  let expiry = addRelTime now (hours 24)
  let cusdc = AssetId with issuer = "ShadowDesk"; symbol = "cUSDC"
  let ctbill = AssetId with issuer = "ShadowDesk"; symbol = "cTBILL"

  cashCid <- submit buyer do
    createCmd (Asset with
      holder = buyer
      id = cusdc
      quantity = 200_000_000.0
      reference = "SEED-BUYER")

  bondCid <- submit dealerA do
    createCmd (Asset with
      holder = dealerA
      id = ctbill
      quantity = 1_000_000.0
      reference = "SEED-DEALER")

  rfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA] expiry "RFQ-SETTLE")

  proposalCid <- submit dealerA do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.50
      bidId = "BID-SETTLE"

  sealedCid <- submit buyer do
    exerciseCmd proposalCid AcceptProposal with
      maxPrice = 101.0

  dealCid <- submit (actAs [buyer, dealerA]) do
    createCmd (Deal with
      reference = "DEAL-0001"
      buyer = buyer
      dealer = dealerA
      security = ctbill
      quantity = 1_000_000.0
      unitPrice = 100.50
      settlementAsset = cusdc
      paymentCid = cashCid
      securityCid = bondCid
      sealedQuote = sealedCid
      expiry = expiry)

  receiptCid <- submit (actAs [buyer, dealerA]) do
    exerciseCmd dealCid Settle

  receiptView <- queryContractId buyer receiptCid
  assertMsg "Buyer holds the settlement receipt" (receiptView /= None)
  let receipt = expectSome "Settlement receipt must exist" receiptView
  assertMsg "Receipt records the awarded bid id" (receipt.bidId == "BID-SETTLE")
  assertMsg "Receipt records the selection policy" (receipt.selectionPolicy == LowestPriceThenBidId)
  assertMsg "Receipt links back to the awarded quote" (receipt.sealedQuote == sealedCid)
  assertMsg "Receipt links back to the originating RFQ" (receipt.rfq == rfqCid)

  dealerAssets <- query @Asset dealerA
  let dealerCash = [(cid, a) | (cid, a) <- dealerAssets, a.id == cusdc]
  let dealerBonds = [(cid, a) | (cid, a) <- dealerAssets, a.id == ctbill]
  assertMsg "Dealer no longer holds the bonds" (length dealerBonds == 0)
  let dealerCashAmount = foldl (\acc (cid, a) -> acc + a.quantity) 0.0 dealerCash
  assertMsg "Dealer received exact payment" (length dealerCash == 1 && dealerCashAmount == 100_500_000.0)

  buyerAssets <- query @Asset buyer
  let buyerBonds = [(cid, a) | (cid, a) <- buyerAssets, a.id == ctbill]
  let buyerBondAmount = foldl (\acc (cid, a) -> acc + a.quantity) 0.0 buyerBonds
  assertMsg "Buyer holds the bought block atomically" (length buyerBonds == 1 && buyerBondAmount == 1_000_000.0)

  submitMustFail (actAs [buyer, dealerA]) do
    exerciseCmd dealCid Settle

runDvPRejectsInvalidLeaves : Script ()
runDvPRejectsInvalidLeaves = do
  buyer <- allocateParty "buyer"
  dealerA <- allocateParty "dealerA"

  now <- getTime
  let expiry = addRelTime now (hours 24)
  let cusdc = AssetId with issuer = "ShadowDesk"; symbol = "cUSDC"
  let ctbill = AssetId with issuer = "ShadowDesk"; symbol = "cTBILL"

  cashCid <- submit buyer do
    createCmd (Asset with
      holder = buyer
      id = cusdc
      quantity = 200_000_000.0
      reference = "SEED-BUYER")

  bondCid <- submit dealerA do
    createCmd (Asset with
      holder = dealerA
      id = ctbill
      quantity = 1_000_000.0
      reference = "SEED-DEALER")

  undersizedCashCid <- submit buyer do
    createCmd (Asset with
      holder = buyer
      id = cusdc
      quantity = 50_000_000.0
      reference = "SEED-BUYER-SMALL")

  undersizedBondCid <- submit dealerA do
    createCmd (Asset with
      holder = dealerA
      id = ctbill
      quantity = 999_999.0
      reference = "SEED-DEALER-EVEN-SMALLER")

  rfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA] expiry "RFQ-BADLEAVES")

  proposalCid <- submit dealerA do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.50
      bidId = "BID-BADLEAVES"

  sealedCid <- submit buyer do
    exerciseCmd proposalCid AcceptProposal with
      maxPrice = 101.0

  subAgreement <- submit (actAs [buyer, dealerA]) do
    createCmd (Deal with
      reference = "DEAL-NOCOVER"
      buyer = buyer
      dealer = dealerA
      security = ctbill
      quantity = 1_000_000.0
      unitPrice = 100.50
      settlementAsset = cusdc
      paymentCid = cashCid
      securityCid = undersizedBondCid
      sealedQuote = sealedCid
      expiry = expiry)

  smallPaymentDeal <- submit (actAs [buyer, dealerA]) do
    createCmd (Deal with
      reference = "DEAL-SMALLPAY"
      buyer = buyer
      dealer = dealerA
      security = ctbill
      quantity = 1_000_000.0
      unitPrice = 100.50
      settlementAsset = cusdc
      paymentCid = undersizedCashCid
      securityCid = bondCid
      sealedQuote = sealedCid
      expiry = expiry)

  submitMustFail (actAs [buyer, dealerA]) do
    exerciseCmd subAgreement Settle

  submitMustFail (actAs [buyer, dealerA]) do
    exerciseCmd smallPaymentDeal Settle

runMultiParticipantPrivacyAndSettlement : Script ()
runMultiParticipantPrivacyAndSettlement = do
  buyer <- allocatePartyOn "buyer" (ParticipantName "participant1")
  dealerA <- allocatePartyOn "dealerA" (ParticipantName "participant1")
  dealerB <- allocatePartyOn "dealerB" (ParticipantName "participant2")

  now <- getTime
  let expiry = addRelTime now (hours 24)
  let cusdc = AssetId with issuer = "ShadowDesk"; symbol = "cUSDC"
  let ctbill = AssetId with issuer = "ShadowDesk"; symbol = "cTBILL"

  cashCid <- submit buyer do
    createCmd (Asset with
      holder = buyer
      id = cusdc
      quantity = 200_000_000.0
      reference = "SEED-BUYER-P1")

  bondCid <- submit dealerA do
    createCmd (Asset with
      holder = dealerA
      id = ctbill
      quantity = 1_000_000.0
      reference = "SEED-DEALER-P1")

  rfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA, dealerB] expiry "RFQ-MULTI")

  proposalACid <- submit dealerA do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.50
      bidId = "BID-A-MULTI"

  proposalBCid <- submit dealerB do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerB
      offeredPrice = 100.20
      bidId = "BID-B-MULTI"

  dealerAViewOfProposalB <- queryContractId dealerA proposalBCid
  assertMsg "Cross-participant: Dealer A cannot see Dealer B proposal" (dealerAViewOfProposalB == (None : Optional QuoteProposal))

  dealerBViewOfProposalA <- queryContractId dealerB proposalACid
  assertMsg "Cross-participant: Dealer B cannot see Dealer A proposal" (dealerBViewOfProposalA == (None : Optional QuoteProposal))

  sealedACid <- submit buyer do
    exerciseCmd proposalACid AcceptProposal with
      maxPrice = 101.0

  dealerBViewOfSealedA <- queryContractId dealerB sealedACid
  assertMsg "Cross-participant: Dealer B cannot see sealed price of A" (dealerBViewOfSealedA == (None : Optional SealedQuote))

  dealCid <- submit (actAs [buyer, dealerA]) do
    createCmd (Deal with
      reference = "DEAL-MULTI"
      buyer = buyer
      dealer = dealerA
      security = ctbill
      quantity = 1_000_000.0
      unitPrice = 100.50
      settlementAsset = cusdc
      paymentCid = cashCid
      securityCid = bondCid
      sealedQuote = sealedACid
      expiry = expiry)

  receiptCid <- submit (actAs [buyer, dealerA]) do
    exerciseCmd dealCid Settle

  receiptView <- queryContractId buyer receiptCid
  assertMsg "Multi-participant settlement receipt exists for buyer" (receiptView /= None)
  let receipt = expectSome "Settlement receipt must exist" receiptView
  assertMsg "Multi-participant receipt records the awarded bid id" (receipt.bidId == "BID-A-MULTI")
  assertMsg "Multi-participant receipt records the selection policy" (receipt.selectionPolicy == LowestPriceThenBidId)

  dealerAssets <- query @Asset dealerA
  let dealerCash = [(cid, a) | (cid, a) <- dealerAssets, a.id == cusdc]
  let dealerBonds = [(cid, a) | (cid, a) <- dealerAssets, a.id == ctbill]
  assertMsg "Dealer no longer holds the bonds" (length dealerBonds == 0)
  let dealerCashAmount = foldl (\acc (cid, a) -> acc + a.quantity) 0.0 dealerCash
  assertMsg "Dealer received exact payment" (length dealerCash == 1 && dealerCashAmount == 100_500_000.0)

  buyerAssets <- query @Asset buyer
  let buyerBonds = [(cid, a) | (cid, a) <- buyerAssets, a.id == ctbill]
  let buyerBondAmount = foldl (\acc (cid, a) -> acc + a.quantity) 0.0 buyerBonds
  assertMsg "Buyer holds the bought block atomically" (length buyerBonds == 1 && buyerBondAmount == 1_000_000.0)

runDealMustMatchAward : Script ()
runDealMustMatchAward = do
  buyer <- allocateParty "buyer"
  dealerA <- allocateParty "dealerA"
  dealerB <- allocateParty "dealerB"

  now <- getTime
  let expiry = addRelTime now (hours 24)
  let cusdc = AssetId with issuer = "ShadowDesk"; symbol = "cUSDC"
  let ctbill = AssetId with issuer = "ShadowDesk"; symbol = "cTBILL"

  cashCid <- submit buyer do
    createCmd (Asset with
      holder = buyer
      id = cusdc
      quantity = 200_000_000.0
      reference = "SEED-BUYER")

  bondCid <- submit dealerA do
    createCmd (Asset with
      holder = dealerA
      id = ctbill
      quantity = 1_000_000.0
      reference = "SEED-DEALER")

  rfqCid <- submit buyer do
    createCmd (rfqTemplate buyer [dealerA] expiry "RFQ-AWARDMATCH")

  proposalCid <- submit dealerA do
    exerciseCmd rfqCid SubmitQuoteProposal with
      dealer = dealerA
      offeredPrice = 100.50
      bidId = "BID-AWARDMATCH"

  sealedCid <- submit buyer do
    exerciseCmd proposalCid AcceptProposal with
      maxPrice = 101.0

  underpricedDeal <- submit (actAs [buyer, dealerA]) do
    createCmd (Deal with
      reference = "DEAL-UNDERPRICE"
      buyer = buyer
      dealer = dealerA
      security = ctbill
      quantity = 1_000_000.0
      unitPrice = 99.00
      settlementAsset = cusdc
      paymentCid = cashCid
      securityCid = bondCid
      sealedQuote = sealedCid
      expiry = expiry)

  submitMustFail (actAs [buyer, dealerA]) do
    exerciseCmd underpricedDeal Settle

  resizedDeal <- submit (actAs [buyer, dealerA]) do
    createCmd (Deal with
      reference = "DEAL-RESIZED"
      buyer = buyer
      dealer = dealerA
      security = ctbill
      quantity = 500_000.0
      unitPrice = 100.50
      settlementAsset = cusdc
      paymentCid = cashCid
      securityCid = bondCid
      sealedQuote = sealedCid
      expiry = expiry)

  submitMustFail (actAs [buyer, dealerA]) do
    exerciseCmd resizedDeal Settle

  wrongDealerDeal <- submit (actAs [buyer, dealerB]) do
    createCmd (Deal with
      reference = "DEAL-WRONGDEALER"
      buyer = buyer
      dealer = dealerB
      security = ctbill
      quantity = 1_000_000.0
      unitPrice = 100.50
      settlementAsset = cusdc
      paymentCid = cashCid
      securityCid = bondCid
      sealedQuote = sealedCid
      expiry = expiry)

  submitMustFail (actAs [buyer, dealerB]) do
    exerciseCmd wrongDealerDeal Settle

  -- The assets must be untouched after every rejected settlement attempt.
  survivingCash <- queryContractId buyer cashCid
  survivingBond <- queryContractId dealerA bondCid
  assertMsg "Payment asset survives a rejected settlement" (survivingCash /= None)
  assertMsg "Security asset survives a rejected settlement" (survivingBond /= None)

noop : Script ()
noop = pure ()
