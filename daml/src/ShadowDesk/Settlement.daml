module ShadowDesk.Settlement where

import ShadowDesk.Asset
import ShadowDesk.Rfq

template Deal
  with
    reference : Text
    buyer : Party
    dealer : Party
    security : AssetId
    quantity : Decimal
    unitPrice : Decimal
    settlementAsset : AssetId
    paymentCid : ContractId Asset
    securityCid : ContractId Asset
    sealedQuote : ContractId SealedQuote
    expiry : Time
  where
    signatory buyer, dealer

    choice Settle : ContractId SettlementReceipt
      controller buyer, dealer
      do
        now <- getTime
        assertMsg "Deal has expired" (this.expiry > now)
        award <- fetch this.sealedQuote
        assertMsg "Deal buyer must match the awarded quote" (award.buyer == this.buyer)
        assertMsg "Deal dealer must match the awarded quote" (award.dealer == this.dealer)
        assertMsg "Awarded quote exceeds the buyer max price" (award.offeredPrice <= award.maxPrice)
        assertMsg "Deal price must match the awarded quote" (award.offeredPrice == this.unitPrice)
        assertMsg "Deal quantity must match the awarded quote" (award.amount == this.quantity)
        assertMsg "Deal security must match the awarded quote" (award.assetToBuy == this.security.symbol)
        assertMsg "Deal settlement asset must match the awarded quote"
          (award.settlementAsset == this.settlementAsset.symbol)
        case award.mandate of
          None -> pure ()
          Some mandateCid -> do
            mandate <- fetch mandateCid
            assertMsg "Deal amount exceeds the approved treasury mandate" (this.quantity <= mandate.maxAmount)
            assertMsg "Deal price exceeds the approved treasury mandate" (this.unitPrice <= mandate.maxPrice)
            assertMsg "Deal security exceeds the approved treasury mandate" (this.security.symbol == mandate.assetToBuy)
            assertMsg "Deal settlement asset exceeds the approved treasury mandate"
              (this.settlementAsset.symbol == mandate.settlementAsset)
        payment <- exercise paymentCid Read
        lockedSecurity <- exercise securityCid Read
        assertMsg "Security amount must match the deal" (lockedSecurity.quantity == this.quantity)
        assertMsg "Settlement asset mismatch" (payment.id == this.settlementAsset)
        assertMsg "Payment must cover deal value" (payment.quantity >= this.quantity * this.unitPrice)
        securityForBuyer <- create Asset with
          holder = this.buyer
          id = lockedSecurity.id
          quantity = lockedSecurity.quantity
          reference = "DVP-BUY-" <> this.reference
        payForDealer <- create Asset with
          holder = this.dealer
          id = payment.id
          quantity = this.quantity * this.unitPrice
          reference = "DVP-PAY-" <> this.reference
        archive paymentCid
        archive securityCid
        create SettlementReceipt with
          reference = this.reference
          buyer = this.buyer
          dealer = this.dealer
          security = lockedSecurity.id
          quantity = this.quantity
          unitPrice = this.unitPrice
          totalValue = this.quantity * this.unitPrice
          rfq = award.rfq
          sealedQuote = this.sealedQuote
          bidId = award.bidId
          selectionPolicy = award.selectionPolicy
          mandate = award.mandate
          settledAt = now

template SettlementReceipt
  with
    reference : Text
    buyer : Party
    dealer : Party
    security : AssetId
    quantity : Decimal
    unitPrice : Decimal
    totalValue : Decimal
    rfq : ContractId BlockTradeRFQ
    sealedQuote : ContractId SealedQuote
    bidId : Text
    selectionPolicy : SelectionPolicy
    mandate : Optional (ContractId ApprovedMandate)
    settledAt : Time
  where
    signatory buyer
    observer dealer
