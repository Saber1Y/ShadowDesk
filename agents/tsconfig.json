{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "buyer/**/*.ts", "dealer/**/*.ts", "demo/**/*.ts", "e2e/**/*.ts"]
}